<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fu_public_product_template_form" model="ir.ui.view">
        <field name="name">product.template.form.fares.public.catalog</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="after">
                <page name="fu_public_catalog" string="Public Catalog" groups="fu_core.group_fu_owner_admin">
                    <group>
                        <group string="Publication">
                            <field name="fu_public_published"/>
                            <field name="fu_public_slug" placeholder="school-polo"/>
                            <field name="fu_public_sequence"/>
                            <field name="fu_public_sector"/>
                        </group>
                        <group string="Public names">
                            <field name="fu_public_name_en"/>
                            <field name="fu_public_name_ar"/>
                        </group>
                    </group>
                    <group string="Public summaries">
                        <field name="fu_public_summary_en" nolabel="1" placeholder="English public catalog summary"/>
                        <field name="fu_public_summary_ar" nolabel="1" placeholder="Arabic public catalog summary"/>
                    </group>
                    <div class="alert alert-info" role="status">
                        Public catalog publication is opt-in. Prices, stock, costs and operational identifiers are never part of the public catalog API.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="fu_public_enquiry_list" model="ir.ui.view">
        <field name="name">fu.public.enquiry.list</field>
        <field name="model">fu.public.enquiry</field>
        <field name="arch" type="xml">
            <list string="Public Enquiries" create="0" edit="0" delete="0">
                <field name="submitted_at"/>
                <field name="reference"/>
                <field name="organization_name"/>
                <field name="contact_name"/>
                <field name="sector"/>
                <field name="phone" optional="show"/>
                <field name="email" optional="show"/>
                <field name="language" optional="hide"/>
                <field name="source_product_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="fu_public_enquiry_form" model="ir.ui.view">
        <field name="name">fu.public.enquiry.form</field>
        <field name="model">fu.public.enquiry</field>
        <field name="arch" type="xml">
            <form string="Public Enquiry" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <label for="reference"/>
                        <h1><field name="reference"/></h1>
                    </div>
                    <group>
                        <group string="Contact">
                            <field name="organization_name"/>
                            <field name="contact_name"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                        <group string="Context">
                            <field name="sector"/>
                            <field name="language"/>
                            <field name="source_product_id"/>
                            <field name="submitted_at"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Requirement">
                        <field name="message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="fu_public_enquiry_search" model="ir.ui.view">
        <field name="name">fu.public.enquiry.search</field>
        <field name="model">fu.public.enquiry</field>
        <field name="arch" type="xml">
            <search string="Public Enquiries">
                <field name="reference"/>
                <field name="organization_name"/>
                <field name="contact_name"/>
                <field name="sector"/>
                <field name="email"/>
                <field name="phone"/>
            </search>
        </field>
    </record>

    <record id="action_fu_public_enquiries" model="ir.actions.act_window">
        <field name="name">Public Enquiries</field>
        <field name="res_model">fu.public.enquiry</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="fu_public_enquiry_search"/>
        <field name="context">{'create': False}</field>
    </record>

    <menuitem
        id="menu_fu_public_enquiries"
        name="Public Enquiries"
        action="action_fu_public_enquiries"
        sequence="75"
        groups="fu_core.group_fu_owner_admin,fu_core.group_fu_sales_bd"
    />
</odoo>
