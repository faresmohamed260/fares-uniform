<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_fu_production_task_company" model="ir.rule">
            <field name="name">Fares production tasks: current companies</field>
            <field name="model_id" ref="model_fu_production_task"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('fu_core.group_fu_owner_admin')), (4, ref('fu_core.group_fu_production_manager'))]"/>
        </record>
        <record id="rule_fu_production_task_line_company" model="ir.rule">
            <field name="name">Fares production task lines: current companies</field>
            <field name="model_id" ref="model_fu_production_task_line"/>
            <field name="domain_force">[('task_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('fu_core.group_fu_owner_admin')), (4, ref('fu_core.group_fu_production_manager'))]"/>
        </record>
        <record id="rule_fu_production_config_company" model="ir.rule">
            <field name="name">Fares production config: current companies</field>
            <field name="model_id" ref="model_fu_production_config"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('fu_core.group_fu_owner_admin')), (4, ref('fu_core.group_fu_production_manager'))]"/>
        </record>
    </data>
</odoo>
