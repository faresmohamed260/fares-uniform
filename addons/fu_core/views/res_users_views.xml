<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fu_res_users_form" model="ir.ui.view">
        <field name="name">fu.res.users.form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="inside">
                <group name="fu_stock_scope" string="Fares Uniform Stock Scope" groups="fu_core.group_fu_owner_admin">
                    <field name="fu_stock_location_ids" widget="many2many_tags" options="{'no_create': True, 'no_quick_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
