<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="fu_retail.ControlButtonsReturns" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//button[@t-on-click='() => this.clickRefund()']" position="replace">
            <button t-if="this.pos.cashier._role != 'minimal'" class="fu-returns-entry" t-att-class="buttonClass" t-on-click="() => this.clickRefund()">
                <i class="fa fa-undo me-1" role="img" aria-label="Returns / Exchanges" title="Returns / Exchanges" />
                Returns / Exchanges
            </button>
        </xpath>
    </t>
</templates>
