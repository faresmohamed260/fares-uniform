msgid "Synced to server"
msgstr "تمت المزامنة مع الخادم"

#. module: fu_retail
#. odoo-javascript
#: code:addons/fu_retail/static/src/receipt_sync_status.xml:0
msgid "This sale is server-confirmed."
msgstr "تم تأكيد هذه العملية على الخادم."

#. module: fu_retail
#. odoo-javascript
#: code:addons/fu_retail/static/src/receipt_sync_status.xml:0
msgid "Review required"
msgstr "مطلوب مراجعة"

#. module: fu_retail
#. odoo-javascript
#: code:addons/fu_retail/static/src/receipt_sync_status.xml:0
msgid "Server could not accept this sale. Keep it on this device and ask a manager to review before retrying."
msgstr "تعذر على الخادم قبول هذه العملية. احتفظ بها على هذا الجهاز واطلب من المدير مراجعتها قبل إعادة المحاولة."

#. module: fu_retail
#. odoo-javascript
#: code:addons/fu_retail/static/src/receipt_sync_status.xml:0
msgid "Syncing with server"
msgstr "جارٍ المزامنة مع الخادم"

#. module: fu_retail
#. odoo-javascript
#: code:addons/fu_retail/static/src/receipt_sync_status.xml:0
msgid "This sale is being sent for server confirmation."
msgstr "جارٍ إرسال هذه العملية إلى الخادم للتأكيد."

#. module: fu_retail
#. odoo-javascript
#: code:addons/fu_retail/static/src/receipt_sync_status.xml:0
msgid "Sync interrupted"
msgstr "انقطعت المزامنة"

#. module: fu_retail
#. odoo-javascript
#: code:addons/fu_retail/static/src/receipt_sync_status.xml:0
msgid "This sale is still saved on this device. Server confirmation failed; retry when the connection is stable."
msgstr "لا تزال هذه العملية محفوظة على هذا الجهاز. فشل تأكيد الخادم؛ أعد المحاولة عندما يستقر الاتصال."

#. module: fu_retail
#. odoo-javascript
#: code:addons/fu_retail/static/src/receipt_sync_status.xml:0
msgid "Saved on this device"
msgstr "تم الحفظ على هذا الجهاز"

#. module: fu_retail
#. odoo-javascript
#: code:addons/fu_retail/static/src/receipt_sync_status.xml:0
msgid "Pending server sync — this sale is not yet server-confirmed."
msgstr "بانتظار المزامنة مع الخادم — لم يتم تأكيد هذه العملية على الخادم بعد."

