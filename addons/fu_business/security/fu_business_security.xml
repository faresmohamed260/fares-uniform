<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_fu_business_lead_owner" model="ir.rule">
            <field name="name">Fares business enquiries: owner all</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('fu_core.group_fu_owner_admin'))]"/>
        </record>
        <record id="rule_fu_business_lead_sales" model="ir.rule">
            <field name="name">Fares business enquiries: assigned sales user</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="domain_force">[('fu_business_client', '=', True), ('company_id', 'in', company_ids), ('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('fu_core.group_fu_sales_bd'))]"/>
        </record>

        <record id="rule_fu_business_order_owner" model="ir.rule">
            <field name="name">Fares business orders: owner all</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('fu_core.group_fu_owner_admin'))]"/>
        </record>
        <record id="rule_fu_business_order_sales" model="ir.rule">
            <field name="name">Fares business orders: assigned sales user</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[('fu_business_order', '=', True), ('company_id', 'in', company_ids), ('opportunity_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('fu_core.group_fu_sales_bd'))]"/>
        </record>
        <record id="rule_fu_business_order_payment_staff" model="ir.rule">
            <field name="name">Fares business orders: payment staff companies</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[('fu_business_order', '=', True), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('fu_core.group_fu_cashier')), (4, ref('fu_core.group_fu_store_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_fu_business_order_inventory" model="ir.rule">
            <field name="name">Fares business orders: inventory shipment context</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[('fu_business_order', '=', True), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('fu_core.group_fu_inventory_staff'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_fu_business_order_line_owner" model="ir.rule">
            <field name="name">Fares business order lines: owner all</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('fu_core.group_fu_owner_admin'))]"/>
        </record>
        <record id="rule_fu_business_order_line_sales" model="ir.rule">
            <field name="name">Fares business order lines: assigned sales user</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="domain_force">[('order_id.fu_business_order', '=', True), ('company_id', 'in', company_ids), ('order_id.opportunity_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('fu_core.group_fu_sales_bd'))]"/>
        </record>
        <record id="rule_fu_business_order_line_operations" model="ir.rule">
            <field name="name">Fares business order lines: operational read</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="domain_force">[('order_id.fu_business_order', '=', True), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('fu_core.group_fu_cashier')), (4, ref('fu_core.group_fu_store_manager')), (4, ref('fu_core.group_fu_inventory_staff'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_fu_business_payment_operations" model="ir.rule">
            <field name="name">Fares business payments: payment staff companies</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="domain_force">[('fu_business_order_id.fu_business_order', '=', True), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('fu_core.group_fu_cashier')), (4, ref('fu_core.group_fu_store_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_fu_business_picking_owner" model="ir.rule">
            <field name="name">Fares stock pickings: owner all</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('fu_core.group_fu_owner_admin'))]"/>
        </record>
        <record id="rule_fu_business_picking_operations" model="ir.rule">
            <field name="name">Fares stock pickings: assigned locations</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', ('location_id', 'in', user.fu_stock_location_ids.ids), ('location_dest_id', 'in', user.fu_stock_location_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('fu_core.group_fu_inventory_staff')), (4, ref('fu_core.group_fu_store_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_fu_business_move_owner" model="ir.rule">
            <field name="name">Fares stock moves: owner all</field>
            <field name="model_id" ref="stock.model_stock_move"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('fu_core.group_fu_owner_admin'))]"/>
        </record>
        <record id="rule_fu_business_move_operations" model="ir.rule">
            <field name="name">Fares stock moves: assigned locations</field>
            <field name="model_id" ref="stock.model_stock_move"/>
            <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', ('location_id', 'in', user.fu_stock_location_ids.ids), ('location_dest_id', 'in', user.fu_stock_location_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('fu_core.group_fu_inventory_staff')), (4, ref('fu_core.group_fu_store_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
