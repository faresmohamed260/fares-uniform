<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_fu_business_lead_owner" model="ir.rule">
            <field name="name">Fares business enquiries: owner companies</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="domain_force">[('fu_business_client', '=', True), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('fu_core.group_fu_owner_admin'))]"/>
        </record>
        <record id="rule_fu_business_lead_sales" model="ir.rule">
            <field name="name">Fares business enquiries: assigned sales user</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="domain_force">[('fu_business_client', '=', True), ('company_id', 'in', company_ids), ('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('fu_core.group_fu_sales_bd'))]"/>
        </record>
        <record id="rule_fu_business_order_owner" model="ir.rule">
            <field name="name">Fares business quotations: owner companies</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[('fu_business_order', '=', True), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('fu_core.group_fu_owner_admin'))]"/>
        </record>
        <record id="rule_fu_business_order_sales" model="ir.rule">
            <field name="name">Fares business quotations: assigned sales user</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[('fu_business_order', '=', True), ('company_id', 'in', company_ids), ('opportunity_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('fu_core.group_fu_sales_bd'))]"/>
        </record>
        <record id="rule_fu_business_order_line_owner" model="ir.rule">
            <field name="name">Fares business quotation lines: owner companies</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="domain_force">[('order_id.fu_business_order', '=', True), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('fu_core.group_fu_owner_admin'))]"/>
        </record>
        <record id="rule_fu_business_order_line_sales" model="ir.rule">
            <field name="name">Fares business quotation lines: assigned sales user</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="domain_force">[('order_id.fu_business_order', '=', True), ('company_id', 'in', company_ids), ('order_id.opportunity_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('fu_core.group_fu_sales_bd'))]"/>
        </record>
    </data>
</odoo>
