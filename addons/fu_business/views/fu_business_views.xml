<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fu_business_lead_list" model="ir.ui.view">
        <field name="name">fu.business.lead.list</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <list string="Business Clients" default_order="date_deadline asc, id desc" delete="0">
                <field name="name"/>
                <field name="partner_name"/>
                <field name="contact_name"/>
                <field name="user_id"/>
                <field name="fu_sample_state"/>
                <field name="date_deadline"/>
            </list>
        </field>
    </record>

    <record id="fu_business_lead_search" model="ir.ui.view">
        <field name="name">fu.business.lead.search</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <search string="Business Clients">
                <field name="name"/>
                <field name="partner_name"/>
                <field name="contact_name"/>
                <field name="user_id"/>
                <field name="fu_sample_state"/>
                <filter name="sample_approved" string="Sample Approved" domain="[('fu_sample_state', '=', 'approved')]"/>
                <filter name="sample_revision" string="Revision Requested" domain="[('fu_sample_state', '=', 'revision')]"/>
                <group>
                    <filter name="group_salesperson" string="Salesperson" context="{'group_by': 'user_id'}"/>
                    <filter name="group_sample" string="Sample Status" context="{'group_by': 'fu_sample_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="fu_business_lead_form" model="ir.ui.view">
        <field name="name">fu.business.lead.form</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <form string="Business Enquiry" delete="0">
                <header>
                    <button name="action_fu_prepare_sample" type="object" string="Start Sample" class="btn-primary" invisible="fu_sample_state not in ('not_started', 'revision')"/>
                    <button name="action_fu_mark_sample_sent" type="object" string="Mark Sample Sent" class="btn-primary" invisible="fu_sample_state != 'preparing'"/>
                    <button name="action_fu_request_revision" type="object" string="Request Revision" invisible="fu_sample_state != 'sent'"/>
                    <button name="action_fu_approve_sample" type="object" string="Approve Sample" class="btn-primary" invisible="fu_sample_state != 'sent'"/>
                    <button name="action_fu_reject_sample" type="object" string="Reject Sample" invisible="fu_sample_state != 'sent'"/>
                    <button name="action_fu_create_business_quotation" type="object" string="Prepare Business Order" class="btn-primary" invisible="fu_sample_state != 'approved'"/>
                    <field name="fu_sample_state" widget="statusbar" statusbar_visible="not_started,preparing,sent,revision,approved,rejected"/>
                </header>
                <sheet>
                    <field name="fu_business_client" invisible="1"/>
                    <div class="alert alert-info" role="alert">
                        Commercial execution follows the accepted Phase 3B deposit, full-balance-before-shipment and no-partial-shipment rules. B2B refunds and credits remain excluded.
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Business enquiry"/></h1>
                    </div>
                    <group>
                        <group string="Client and contact">
                            <field name="partner_id"/>
                            <field name="partner_name"/>
                            <field name="contact_name"/>
                            <field name="email_from"/>
                            <field name="phone"/>
                            <field name="user_id" readonly="1"/>
                            <field name="date_deadline"/>
                        </group>
                        <group string="Design and sample">
                            <field name="fu_design_requirements"/>
                            <field name="fu_sample_reference"/>
                            <field name="fu_sample_notes"/>
                            <field name="fu_sample_sent_by_id" readonly="1"/>
                            <field name="fu_sample_sent_at" readonly="1"/>
                            <field name="fu_sample_decided_by_id" readonly="1"/>
                            <field name="fu_sample_decided_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Meeting / enquiry notes">
                        <field name="description" nolabel="1" placeholder="Record design discussion, requirements and follow-up notes..."/>
                    </group>
                    <group string="Business orders">
                        <field name="order_ids" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_fu_business_clients" model="ir.actions.act_window">
        <field name="name">Business Clients</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('fu_business_client', '=', True)]</field>
        <field name="context">{'default_fu_business_client': True, 'default_type': 'opportunity'}</field>
    </record>
    <record id="action_fu_business_clients_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="fu_business_lead_list"/>
        <field name="act_window_id" ref="action_fu_business_clients"/>
    </record>
    <record id="action_fu_business_clients_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="fu_business_lead_form"/>
        <field name="act_window_id" ref="action_fu_business_clients"/>
    </record>

    <record id="fu_business_sale_order_list" model="ir.ui.view">
        <field name="name">fu.business.sale.order.list</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list string="Business Orders" create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="opportunity_id"/>
                <field name="amount_total"/>
                <field name="fu_business_amount_paid"/>
                <field name="fu_business_balance_due"/>
                <field name="fu_business_payment_state"/>
                <field name="commitment_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="fu_business_sale_order_form" model="ir.ui.view">
        <field name="name">fu.business.sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <form string="Business Order" create="0" edit="0" delete="0">
                <header>
                    <button name="action_fu_open_draft_editor" type="object" string="Edit Draft Details" class="btn-primary" groups="fu_core.group_fu_sales_bd" invisible="state != 'draft' or fu_business_amount_paid &gt; 0"/>
                    <button name="action_fu_open_draft_editor" type="object" string="Edit / Approve Draft Change" class="btn-primary" groups="fu_core.group_fu_owner_admin" invisible="state != 'draft'"/>
                    <button name="action_fu_open_business_payment" type="object" string="Record Payment" class="btn-primary" groups="fu_core.group_fu_owner_admin,fu_core.group_fu_store_manager,fu_core.group_fu_cashier" invisible="state not in ('draft', 'sale') or fu_business_balance_due &lt;= 0"/>
                    <button name="action_fu_confirm_business_order" type="object" string="Confirm Business Order" class="btn-primary" groups="fu_core.group_fu_owner_admin,fu_core.group_fu_sales_bd" invisible="state != 'draft' or fu_business_amount_paid &lt;= 0"/>
                    <button name="action_fu_cancel_business_draft" type="object" string="Cancel Unpaid Draft" groups="fu_core.group_fu_owner_admin,fu_core.group_fu_sales_bd" invisible="state != 'draft' or fu_business_amount_paid &gt; 0"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sale,cancel"/>
                </header>
                <sheet>
                    <field name="fu_business_order" invisible="1"/>
                    <div class="alert alert-warning" role="alert">
                        A positive negotiated deposit is required before confirmation. The full remaining balance is required before complete shipment release. Partial shipment and cancellation after payment are blocked in this MVP.
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Commercial terms">
                            <field name="partner_id" readonly="1"/>
                            <field name="opportunity_id" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="client_order_ref" readonly="1"/>
                            <field name="commitment_date" readonly="1"/>
                        </group>
                        <group string="Payment and release">
                            <field name="amount_untaxed" readonly="1"/>
                            <field name="amount_total" readonly="1"/>
                            <field name="fu_business_amount_paid" readonly="1"/>
                            <field name="fu_business_balance_due" readonly="1"/>
                            <field name="fu_business_payment_state" readonly="1"/>
                        </group>
                    </group>
                    <group string="Commercial audit">
                        <group>
                            <field name="fu_business_confirmed_by_id" readonly="1"/>
                            <field name="fu_business_confirmed_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="fu_business_change_approved_by_id" readonly="1"/>
                            <field name="fu_business_change_approved_at" readonly="1"/>
                        </group>
                    </group>
                    <field name="order_line" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="product_id"/>
                            <field name="product_uom_qty"/>
                            <field name="price_unit"/>
                            <field name="price_subtotal"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="fu_business_quotation_wizard_form" model="ir.ui.view">
        <field name="name">fu.business.quotation.wizard.form</field>
        <field name="model">fu.business.quotation.wizard</field>
        <field name="arch" type="xml">
            <form string="Draft Quotation Details">
                <sheet>
                    <field name="quotation_id" invisible="1"/>
                    <div class="alert alert-warning" role="alert">
                        Before payment, assigned Sales/BD may edit the draft. After payment, only Owner/Admin may approve a draft commercial change. Saving never authorizes shipment.
                    </div>
                    <group string="Commercial details">
                        <field name="client_order_ref"/>
                        <field name="commitment_date"/>
                    </group>
                    <group string="Candidate items">
                        <field name="line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="product_id"/>
                                <field name="quantity"/>
                                <field name="unit_price"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="action_save_draft" type="object" string="Save Draft" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fu_business_quotation_editor" model="ir.actions.act_window">
        <field name="name">Draft Quotation Details</field>
        <field name="res_model">fu.business.quotation.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="fu_business_quotation_wizard_form"/>
        <field name="target">new</field>
    </record>

    <record id="fu_business_payment_wizard_form" model="ir.ui.view">
        <field name="name">fu.business.payment.wizard.form</field>
        <field name="model">fu.business.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Record Business Payment">
                <sheet>
                    <field name="order_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="requires_manual_confirmation" invisible="1"/>
                    <field name="payment_uuid" invisible="1"/>
                    <div class="alert alert-info" role="alert">
                        Enter the negotiated positive deposit or later balance payment. No deposit percentage is preselected. Payments cannot exceed the remaining balance.
                    </div>
                    <group>
                        <field name="balance_due" readonly="1"/>
                        <field name="amount"/>
                        <field name="journal_key"/>
                        <field name="manual_confirmed" invisible="not requires_manual_confirmation"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_record_payment" type="object" string="Record Payment" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fu_business_payment_wizard" model="ir.actions.act_window">
        <field name="name">Record Business Payment</field>
        <field name="res_model">fu.business.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="fu_business_payment_wizard_form"/>
        <field name="target">new</field>
    </record>

    <record id="action_fu_business_quotations" model="ir.actions.act_window">
        <field name="name">Business Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('fu_business_order', '=', True)]</field>
    </record>
    <record id="action_fu_business_quotations_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="fu_business_sale_order_list"/>
        <field name="act_window_id" ref="action_fu_business_quotations"/>
    </record>
    <record id="action_fu_business_quotations_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="fu_business_sale_order_form"/>
        <field name="act_window_id" ref="action_fu_business_quotations"/>
    </record>

    <record id="fu_business_delivery_list" model="ir.ui.view">
        <field name="name">fu.business.delivery.list</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <list string="Business Deliveries" create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="sale_id"/>
                <field name="partner_id"/>
                <field name="location_id"/>
                <field name="scheduled_date"/>
                <field name="state"/>
                <field name="fu_business_released_by_id"/>
            </list>
        </field>
    </record>

    <record id="fu_business_delivery_form" model="ir.ui.view">
        <field name="name">fu.business.delivery.form</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <form string="Business Delivery" create="0" edit="0" delete="0">
                <header>
                    <button name="fu_release_business_delivery" type="object" string="Release Complete Shipment" class="btn-primary" groups="fu_core.group_fu_owner_admin,fu_core.group_fu_store_manager,fu_core.group_fu_inventory_staff" invisible="state in ('done', 'cancel')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        Release is allowed only when the whole business-order balance is paid and every ordered item is available in this single delivery. Partial shipment is disabled.
                    </div>
                    <group>
                        <group string="Delivery">
                            <field name="name" readonly="1"/>
                            <field name="sale_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="scheduled_date" readonly="1"/>
                        </group>
                        <group string="Stock scope">
                            <field name="location_id" readonly="1"/>
                            <field name="location_dest_id" readonly="1"/>
                            <field name="fu_business_released_by_id" readonly="1"/>
                            <field name="fu_business_released_at" readonly="1"/>
                        </group>
                    </group>
                    <field name="move_ids" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="product_id"/>
                            <field name="product_uom_qty"/>
                            <field name="quantity"/>
                            <field name="state"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fu_business_deliveries" model="ir.actions.act_window">
        <field name="name">Business Deliveries</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('sale_id.fu_business_order', '=', True), ('location_dest_id.usage', '=', 'customer')]</field>
    </record>
    <record id="action_fu_business_deliveries_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="fu_business_delivery_list"/>
        <field name="act_window_id" ref="action_fu_business_deliveries"/>
    </record>
    <record id="action_fu_business_deliveries_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="fu_business_delivery_form"/>
        <field name="act_window_id" ref="action_fu_business_deliveries"/>
    </record>

    <menuitem id="menu_fu_business_root" name="Business Clients" sequence="55" groups="fu_core.group_fu_owner_admin,fu_core.group_fu_sales_bd,fu_core.group_fu_store_manager,fu_core.group_fu_cashier,fu_core.group_fu_inventory_staff"/>
    <menuitem id="menu_fu_business_clients" name="Enquiries &amp; Samples" parent="menu_fu_business_root" action="action_fu_business_clients" sequence="10" groups="fu_core.group_fu_owner_admin,fu_core.group_fu_sales_bd"/>
    <menuitem id="menu_fu_business_quotations" name="Business Orders &amp; Payments" parent="menu_fu_business_root" action="action_fu_business_quotations" sequence="20" groups="fu_core.group_fu_owner_admin,fu_core.group_fu_sales_bd,fu_core.group_fu_store_manager,fu_core.group_fu_cashier"/>
    <menuitem id="menu_fu_business_deliveries" name="Business Deliveries" parent="menu_fu_business_root" action="action_fu_business_deliveries" sequence="30" groups="fu_core.group_fu_owner_admin,fu_core.group_fu_store_manager,fu_core.group_fu_inventory_staff"/>
</odoo>
