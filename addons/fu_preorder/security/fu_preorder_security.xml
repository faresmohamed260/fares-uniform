<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_fu_preorder_sale_order_store_scope" model="ir.rule">
            <field name="name">Fares preorders: assigned stores only</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[('fu_is_preorder', '=', True), ('fu_store_location_id', 'in', user.fu_stock_location_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('fu_core.group_fu_cashier')), (4, ref('fu_core.group_fu_store_manager')), (4, ref('fu_core.group_fu_inventory_staff'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_fu_preorder_sale_order_owner_all" model="ir.rule">
            <field name="name">Fares preorders: owner all</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('fu_core.group_fu_owner_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_fu_preorder_sale_line_store_scope" model="ir.rule">
            <field name="name">Fares preorder lines: assigned stores only</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="domain_force">[('order_id.fu_is_preorder', '=', True), ('order_id.fu_store_location_id', 'in', user.fu_stock_location_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('fu_core.group_fu_cashier')), (4, ref('fu_core.group_fu_store_manager')), (4, ref('fu_core.group_fu_inventory_staff'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_fu_preorder_sale_line_owner_all" model="ir.rule">
            <field name="name">Fares preorder lines: owner all</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('fu_core.group_fu_owner_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_fu_preorder_payment_store_scope" model="ir.rule">
            <field name="name">Fares preorder payments: assigned stores only</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="domain_force">[('fu_preorder_id.fu_is_preorder', '=', True), ('fu_preorder_id.fu_store_location_id', 'in', user.fu_stock_location_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('fu_core.group_fu_cashier')), (4, ref('fu_core.group_fu_store_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_fu_preorder_payment_owner_all" model="ir.rule">
            <field name="name">Fares preorder payments: owner all</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('fu_core.group_fu_owner_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
