<odoo>
  <record id="task_list" model="ir.ui.view">
    <field name="name">fu.proof.task.list</field><field name="model">fu.proof.task</field>
    <field name="arch" type="xml"><list><field name="product_id"/><field name="state"/></list></field>
  </record>
  <record id="task_form" model="ir.ui.view">
    <field name="name">fu.proof.task.form</field><field name="model">fu.proof.task</field>
    <field name="arch" type="xml">
      <form><header><button name="advance" type="object" string="Advance demonstration" class="oe_highlight"/><field name="state" widget="statusbar"/></header>
      <sheet><h1><field name="product_id"/></h1><p>Synthetic workflow proof. Payment and stock integration are not implemented.</p>
      <field name="line_ids"><list><field name="order_id"/><field name="quantity"/><field name="collected"/><field name="pickup_date"/></list></field></sheet></form>
    </field>
  </record>
  <record id="tasks" model="ir.actions.act_window"><field name="name">Fares Uniform proof tasks</field><field name="res_model">fu.proof.task</field><field name="view_mode">list,form</field></record>
  <menuitem id="root_menu" name="Fares Uniform proof" groups="base.group_system"/>
  <menuitem id="task_menu" parent="root_menu" name="Production tasks" action="tasks"/>
</odoo>
