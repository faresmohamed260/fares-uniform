# Copy to an untracked runtime env file and replace paths/values for the target host.
# Never commit real secret contents.

COMPOSE_PROJECT_NAME=fares-uniform
FARES_SHA=replace-with-exact-fares-git-sha
ODOO_SHA=1a13ceeaee12fe5cc50f287c31f217d4be2a2eaf

ODOO_DB_NAME=fares
ODOO_DB_USER=fares_app
ODOO_WORKERS=2
ODOO_MAX_CRON_THREADS=1
ODOO_DB_MAXCONN=32
ODOO_LIMIT_MEMORY_SOFT=1073741824
ODOO_LIMIT_MEMORY_HARD=1342177280
ODOO_LIMIT_TIME_CPU=120
ODOO_LIMIT_TIME_REAL=240
ODOO_LIMIT_TIME_REAL_CRON=600
ODOO_LOG_LEVEL=info

HTTP_PORT=8080
HTTPS_PORT=8443

# These paths point to files containing secret values, not the values themselves.
# Docker Compose file-backed secrets are bind mounts and preserve host ownership/mode.
# Prepare them on the deployment host before startup as follows:
#   postgres_superuser_password -> root:root, mode 0400
#   odoo_db_password            -> root:10001, mode 0440
#   odoo_admin_passwd           -> root:10001, mode 0440
# GID 10001 is Odoo's fixed runtime group; the Fares PostgreSQL image grants the
# postgres user supplementary membership in the same secret-reader GID.
POSTGRES_SUPERUSER_PASSWORD_FILE=./.secrets/postgres_superuser_password
ODOO_DB_PASSWORD_FILE=./.secrets/odoo_db_password
ODOO_ADMIN_PASSWD_FILE=./.secrets/odoo_admin_passwd
TLS_CERT_FILE=./.runtime/tls/fullchain.pem
TLS_KEY_FILE=./.runtime/tls/privkey.pem
BACKUP_BIND_DIR=./.runtime/backups

# Optional off-host S3-compatible upload variables are intentionally omitted here.
# Supply S3_ENDPOINT_URL, S3_BUCKET, S3_PREFIX and standard AWS credential variables
# only from the selected runtime secret store when off-host upload is authorized.
